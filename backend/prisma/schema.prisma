// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TeamType {
  HiddenKing  
  Archmother
}

model Player {
  account_id Int                @id
  name       String
  matches    MatchParticipant[]
}

model Match {
  match_id     Int                @id
  duration     Int
  winner_team  String
  participants MatchParticipant[]
}

model MatchParticipant {
  id         String   @id @default(uuid())
  account_id Int
  match_id   Int
  hero_id    Int
  hero_lvl   Int
  team       TeamType
  denies     Int
  net_worth  Int
  last_hits  Int
  kills      Int
  deaths     Int
  assists    Int
  is_winner  Boolean
  abandoned  Boolean
  damage     Int
  player     Player   @relation(fields: [account_id], references: [account_id])
  match      Match    @relation(fields: [match_id], references: [match_id])

  @@unique([account_id, match_id])
}
